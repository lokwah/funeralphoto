---
// FAQ 摺疊列表：用 <details>，唔使 JavaScript，搜尋器同 AI 都讀到全部答案
import type { FaqItem } from '../data/faq';
interface Props { items: FaqItem[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary><h3>{f.q}</h3><span class="plus" aria-hidden="true"></span></summary>
      <div class="a">
        <p>{f.a}</p>
        {f.link && <p><a href={f.link.href}>了解更多：{f.link.label} →</a></p>}
      </div>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { font-size: var(--fs-lg); font-weight: 500; margin: 0; line-height: 1.5; }
  summary:hover h3 { color: var(--gold); }
  .plus { position: relative; flex: 0 0 28px; height: 28px; border: 1px solid var(--line-strong); border-radius: 50%; }
  .plus::before, .plus::after { content: ''; position: absolute; top: 50%; left: 50%; width: 11px; height: 1.5px; background: var(--gold); transform: translate(-50%, -50%); }
  .plus::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform .2s; }
  details[open] .plus::after { transform: translate(-50%, -50%) rotate(0); }
  .a { padding: 0 44px 20px 0; color: var(--ivory-dim); }
  .a p:last-child { margin-bottom: 0; }
</style>
