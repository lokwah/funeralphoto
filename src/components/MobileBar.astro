---
import { wa } from '../data/site';
---
<div class="mbar" aria-label="快速聯絡">
  <a class="btn btn-line" href={wa()} target="_blank" rel="noopener">WhatsApp 查詢</a>
  <a class="btn btn-gold" href="/order/">訂購</a>
</div>

<style>
  .mbar { display: none; }
  @media (max-width: 900px) {
    .mbar { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: rgba(5,4,3,.97); border-top: 1px solid var(--line); }
    .mbar .btn { min-height: 46px; }
  }
</style>
