---
// 頁尾行動區：訂購 + WhatsApp
import { SITE, wa } from '../data/site';
interface Props { title?: string; text?: string; waText?: string; orderLabel?: string }
const {
  title = '準備好相片，就可以開始',
  text = 'WhatsApp 傳送 2–3 張候選相片，免費初步評估；確認後網上落單，一口價收費，不另收費。',
  waText = 'Hi',
  orderLabel = '網上訂購',
} = Astro.props;
---
<section class="section section-deep cta">
  <div class="container narrow center">
    <h2>{title}</h2>
    <p class="lead">{text}</p>
    <div class="btn-row">
      <a class="btn btn-gold" href={SITE.formUrl} target="_blank" rel="noopener">{orderLabel}</a>
      <a class="btn btn-line" href={wa(waText)} target="_blank" rel="noopener">WhatsApp 免費初步評估</a>
    </div>
  </div>
</section>

<style>
  .center { text-align: center; }
  .lead { margin: 0 auto 28px; }
  .btn-row { justify-content: center; }
</style>
